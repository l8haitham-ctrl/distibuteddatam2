# Local development only. Copy to .env and choose a strong password.
# At least 8 characters, including uppercase, lowercase, digits and symbols.
MSSQL_SA_PASSWORD=ChangeMe_Local2026!
SQLSERVER_PORT=1433
SEED_SCALE=small
# Optional count overrides, applied only to empty databases or explicit reseeds.
SEED_CUSTOMERS=
SEED_INVOICES=
# Separate account for read-only source exploration.
LAKE_READER_PASSWORD=ChangeMe_Reader2026!
# Local MinIO administrator, used only by MinIO and storage-init.
MINIO_ROOT_USER=atlas-admin
MINIO_ROOT_PASSWORD=ChangeMe_StorageAdmin2026!
# Application account restricted to STORAGE_BUCKET by storage-init.
STORAGE_ACCESS_KEY=atlas-storage
STORAGE_SECRET_KEY=ChangeMe_StorageApp2026!
STORAGE_BUCKET=lake
STORAGE_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Metadata database: separate administrator and application credentials.
POSTGRES_ADMIN_PASSWORD=ChangeMe_MetadataAdmin2026!
JOBS_PASSWORD=ChangeMe_MetadataApp2026!
SPARK_UI_PORT=8088

# Hive catalogue / Trino (independent credentials; supply strong values)
METASTORE_PASSWORD=
TRINO_S3_ACCESS_KEY=atlas_trino_reader
TRINO_S3_SECRET_KEY=
TRINO_REGISTRAR_PASSWORD=
TRINO_READER_PASSWORD=
TRINO_KEYSTORE_PASSWORD=
TRINO_SHARED_SECRET=
TRINO_PORT=8089

# Optional PostgreSQL business source (docker-compose.connectors.yml).
# Use distinct strong secrets; existing volumes keep their original passwords.
PG_SOURCE_ADMIN_PASSWORD=
PG_SOURCE_READER_PASSWORD=
# Optional local Redis analytics fixture (distinct random values, >=16 characters).
REDIS_ADMIN_PASSWORD=replace-with-a-random-admin-secret
REDIS_READER_PASSWORD=replace-with-a-different-reader-secret

# Local platform login (independent from database accounts; never commit .env).
APP_LOGIN_USERNAME=admin
APP_LOGIN_PASSWORD=
# false for localhost HTTP; true behind HTTPS in a deployed environment.
APP_COOKIE_SECURE=false
