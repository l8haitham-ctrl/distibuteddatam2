# Local development only. Copy to .env and choose a strong password.
# At least 8 characters, including uppercase, lowercase, digits and symbols.
MSSQL_SA_PASSWORD=ChangeMe_Local2026!
SQLSERVER_PORT=1433
# Separate account for read-only source exploration.
LAKE_READER_PASSWORD=ChangeMe_Reader2026!
# Local MinIO administrator, used only by MinIO and storage-init.
MINIO_ROOT_USER=atlas-admin
MINIO_ROOT_PASSWORD=ChangeMe_StorageAdmin2026!
# Application account restricted to STORAGE_BUCKET by storage-init.
STORAGE_ACCESS_KEY=atlas-storage
STORAGE_SECRET_KEY=ChangeMe_StorageApp2026!
STORAGE_BUCKET=lake
STORAGE_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Metadata database: separate administrator and application credentials.
POSTGRES_ADMIN_PASSWORD=ChangeMe_MetadataAdmin2026!
JOBS_PASSWORD=ChangeMe_MetadataApp2026!
SPARK_UI_PORT=8088
