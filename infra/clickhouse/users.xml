<clickhouse>
  <profiles>
    <atlas_reader>
      <readonly>1</readonly>
      <max_execution_time>5</max_execution_time>
      <max_memory_usage>134217728</max_memory_usage>
      <max_threads>2</max_threads>
    </atlas_reader>
  </profiles>
  <users>
    <atlas_reader>
      <password from_env="CLICKHOUSE_READER_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>atlas_reader</profile>
      <quota>default</quota>
      <grants>
        <query>GRANT SELECT ON analytics.*</query>
        <query>GRANT SELECT ON system.databases</query>
        <query>GRANT SELECT ON system.tables</query>
        <query>GRANT SELECT ON system.columns</query>
      </grants>
    </atlas_reader>
  </users>
</clickhouse>
